@startuml Diagrama_Classes_Diario_Enxaqueca

skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    ArrowColor #1976D2
}

' === ENTIDADES ===

class Usuario {
    - id: Integer {PK}
    - nome: String
    - email: String {unique}
    - senha_hash: String
    - data_cadastro: DateTime
    --
    + criar_usuario()
    + autenticar(email, senha): Token
    + atualizar_perfil()
    + excluir_conta()
    + listar_episodios(): List<Episodio>
}

class Episodio {
    - id: Integer {PK}
    - usuario_id: Integer {FK}
    - data: Date
    - intensidade: Integer [0-10]
    - duracao: Integer (minutos)
    - observacoes: String (max 500)
    - data_criacao: DateTime
    - data_atualizacao: DateTime
    --
    + criar_episodio()
    + editar_episodio()
    + excluir_episodio()
    + adicionar_gatilho(gatilho: Gatilho)
    + adicionar_medicacao(medicacao: Medicacao)
    + listar_detalhes(): Dict
}

class Gatilho {
    - id: Integer {PK}
    - usuario_id: Integer {FK}
    - nome: String {unique per user}
    - data_criacao: DateTime
    --
    + criar_gatilho()
    + editar_gatilho()
    + excluir_gatilho()
    + listar_episodios_relacionados(): List<Episodio>
}

class Medicacao {
    - id: Integer {PK}
    - usuario_id: Integer {FK}
    - nome: String {unique per user}
    - dosagem: String (opcional)
    - data_criacao: DateTime
    --
    + criar_medicacao()
    + editar_medicacao()
    + excluir_medicacao()
    + listar_episodios_relacionados(): List<Episodio>
}

class EpisodioGatilho {
    - episodio_id: Integer {FK}
    - gatilho_id: Integer {FK}
    --
    Tabela de associação N:N
}

class EpisodioMedicacao {
    - episodio_id: Integer {FK}
    - medicacao_id: Integer {FK}
    --
    Tabela de associação N:N
}

class Dashboard {
    <<service>>
    --
    + calcular_intensidade_media(usuario: Usuario): Float
    + contar_episodios_mes(usuario: Usuario): Integer
    + listar_gatilhos_frequentes(usuario: Usuario, limit: Integer): List
    + gerar_grafico_mensal(usuario: Usuario, meses: Integer): Dict
}

' === RELACIONAMENTOS ===

Usuario "1" -- "0..*" Episodio : possui >
Usuario "1" -- "0..*" Gatilho : possui >
Usuario "1" -- "0..*" Medicacao : possui >

Episodio "0..*" -- "0..*" Gatilho : associado a >
(Episodio, Gatilho) .. EpisodioGatilho

Episodio "0..*" -- "0..*" Medicacao : associado a >
(Episodio, Medicacao) .. EpisodioMedicacao

Dashboard ..> Usuario : consulta
Dashboard ..> Episodio : analisa

' === NOTAS ===

note right of Usuario
  - Email único no sistema
  - Senha armazenada como hash
  - Pode criar múltiplos episódios
end note

note right of Episodio
  - Data não pode ser futura
  - Intensidade: 0 a 10
  - Observações: max 500 caracteres
end note

note bottom of EpisodioGatilho
  Relacionamento Many-to-Many
  entre Episódio e Gatilho
end note

note bottom of EpisodioMedicacao
  Relacionamento Many-to-Many
  entre Episódio e Medicação
end note

@enduml
