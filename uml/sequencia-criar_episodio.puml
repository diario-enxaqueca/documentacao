@startuml Sequencia_Criar_Episodio

skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #1976D2
    ActorBorderColor #1976D2
    LifeLineBorderColor #1976D2
    ParticipantBorderColor #1976D2
    ParticipantBackgroundColor #E3F2FD
}

actor Usuario as user
participant "Frontend\n(React)" as frontend
participant "API\n(FastAPI)" as api
participant "Controller\nEpisodio" as controller
participant "Model\nEpisodio" as model
participant "Validação\n(Pydantic)" as validation
database "MySQL\nDatabase" as db

== Criação de Episódio ==

user -> frontend: Preenche formulário\n(data, intensidade, gatilhos, etc.)
activate frontend

frontend -> frontend: Valida campos\nobrigatórios
frontend -> api: POST /episodios\n+ JWT Token\n+ JSON payload
activate api

api -> api: Verifica JWT Token
alt Token inválido
    api --> frontend: 401 Unauthorized
    frontend --> user: "Token inválido"
end

api -> controller: criar_episodio(data)
activate controller

controller -> validation: Valida payload
activate validation
validation -> validation: Verifica:\n- data não futura\n- intensidade 0-10\n- observações <= 500 chars
alt Validação falha
    validation --> controller: ValidationError
    controller --> api: 400 Bad Request
    api --> frontend: Erro de validação
    frontend --> user: "Dados inválidos"
end
validation --> controller: Dados válidos
deactivate validation

controller -> model: Episodio.create(data)
activate model

model -> db: INSERT INTO episodios\n(usuario_id, data, intensidade, ...)
activate db
db --> model: episodio_id
deactivate db

alt Gatilhos informados
    model -> db: INSERT INTO episodio_gatilho\n(episodio_id, gatilho_id)
    activate db
    db --> model: OK
    deactivate db
end

alt Medicações informadas
    model -> db: INSERT INTO episodio_medicacao\n(episodio_id, medicacao_id)
    activate db
    db --> model: OK
    deactivate db
end

model --> controller: episodio criado
deactivate model

controller --> api: 201 Created\n+ JSON episodio
deactivate controller

api --> frontend: 201 Created\n+ JSON episodio
deactivate api

frontend -> frontend: Atualiza lista\nde episódios
frontend --> user: "Episódio criado\ncom sucesso!"
deactivate frontend

@enduml
