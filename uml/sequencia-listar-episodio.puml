@startuml Sequencia_Listar_Episodios

skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #E67E22
    ActorBorderColor #E67E22
    LifeLineBorderColor #E67E22
    ParticipantBorderColor #E67E22
    ParticipantBackgroundColor #FEF5E7
}

actor Usuario as user
participant "Frontend\n(React)" as frontend
participant "API\n(FastAPI)" as api
participant "Controller\nEpisodio" as controller
participant "Model\nEpisodio" as model
database "MySQL\nDatabase" as db

== Listar Episódios com Filtros ==

user -> frontend: Acessa lista\nde episódios
activate frontend

frontend -> api: GET /episodios\n?intensidade_min=7\n&data_inicio=2025-10-01\n+ JWT Token
activate api

api -> api: Verifica JWT Token
api -> controller: listar_episodios(usuario_id, filtros)
activate controller

controller -> model: Episodio.query()\n.filter(usuario_id, intensidade>=7, data>=2025-10-01)\n.order_by(data DESC)
activate model

model -> db: SELECT * FROM episodios\nWHERE usuario_id = ?\nAND intensidade >= 7\nAND data >= '2025-10-01'\nORDER BY data DESC\nLIMIT 10
activate db
db --> model: List<episodio>
deactivate db

model -> model: Carrega relações\n(gatilhos, medicações)

model -> db: SELECT * FROM episodio_gatilho\nWHERE episodio_id IN (...)
activate db
db --> model: gatilhos
deactivate db

model -> db: SELECT * FROM episodio_medicacao\nWHERE episodio_id IN (...)
activate db
db --> model: medicações
deactivate db

model --> controller: List<episodio_completo>
deactivate model

controller --> api: 200 OK\n+ JSON [episodios]
deactivate controller

api --> frontend: 200 OK\n+ JSON [episodios]
deactivate api

frontend -> frontend: Renderiza lista\ncom cartões de episódios
frontend --> user: Exibe episódios\nfiltrados
deactivate frontend

@enduml
